# Copy this file to .env and fill in your Supabase credentials
# Get these from: https://app.supabase.com → Your Project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

DATABASE_URL=postgresql://postgres:TestAdmin@103.182.211.219:5432/assetPortal_db
# Express API listen port (default 5355). Use API_PORT — not PORT — so a stray PORT=3001 in .env does not break the Vite proxy (5355).
API_PORT=5355